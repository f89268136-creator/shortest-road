    def on_add_road(self):
        a = self.combo_a.get()
        b = self.combo_b.get()
        km_str = self.entry_km.get().strip()
        if a == "" or b == "" or km_str == "":
            messagebox.showwarning("提示", "请选择两个城市并填写里程")
            return
        if a == b:
            messagebox.showwarning("提示", "两个城市不能相同")
            return
        try:
            km = int(km_str)
        except ValueError:
            messagebox.showwarning("提示", "里程必须是整数（公里）")
            return
        if km <= 0:
            messagebox.showwarning("提示", "里程必须大于 0")
            return
        ia = city_index(a)
        ib = city_index(b)
        self.graph.set_edge(ia, ib, km)
        cnt = len(self.graph.edges_between(ia, ib))
        self.update_status()
        self.draw_graph()
        if cnt > 1:
            self.show_result("已添加道路：%s — %s，里程 %d 公里\n"
                             "该路段现有 %d 条平行路（图上错位显示）。\n"
                             "Dijkstra / Prim 自动选取其中里程最短的一条。"
                             % (a, b, km, cnt))
        else:
            self.show_result("已添加道路：%s — %s，里程 %d 公里\n可重新选择城市查询。" % (a, b, km))

    def on_delete_road(self):
        a = self.combo_a.get()
        b = self.combo_b.get()
        if a == "" or b == "" or a == b:
            messagebox.showwarning("提示", "请选择两个不同的城市")
            return
        ia = city_index(a)
        ib = city_index(b)
        if self.graph.delete_edge(ia, ib):
            cnt = len(self.graph.edges_between(ia, ib))
            self.update_status()
            self.draw_graph()
            if cnt > 0:
                self.show_result("已删除一条道路：%s — %s（该路段剩余 %d 条平行路）" % (a, b, cnt))
            else:
                self.show_result("已删除道路：%s — %s" % (a, b))
        else:
            self.show_result("道路 %s — %s 不存在，无需删除" % (a, b))

    def reset_highlight(self):
        self.draw_graph()
        self.show_result("已清空高亮。可选择出发/到达城市后点击“最短路径”或“最少经停”。")

    def refresh_names(self):
        names = [CITIES[i][0] for i in range(len(CITIES))]
        self.combo_from["values"] = names
        self.combo_to["values"] = names
        self.combo_via["values"] = ["（不途经）"] + names
        self.combo_via.set("（不途经）")
        self.combo_a["values"] = names
        self.combo_b["values"] = names

    def start_import(self):
        cache = network._load_cache()
        if cache is not None:
            self._import_done(cache + (0,),
                              ["已从本地缓存加载路网（road_network_cache.json），"
                               "无需重新请求百度接口"])
            return
        self.on_import_real()

    def on_import_real(self):
        ak = self.ak.strip()
        if ak == "" or ak == AK_PLACEHOLDER:
            ak = simpledialog.askstring(
                "百度地图 AK",
                "请在 data.py 顶部把 BAIDU_AK 常量改为你的百度地图开放平台 AK；\n"
                "或在此临时输入本次使用（lbsyun.baidu.com 免费申请）：",
                parent=self.root, initialvalue="")
            if ak is None or ak.strip() == "":
                self.show_result("未导入路网：需要百度地图 AK。\n"
                                 "获取方式：lbsyun.baidu.com 注册应用后复制 AK，"
                                 "填入 data.py 顶部 BAIDU_AK = \"...\"，重启程序即可自动导入真实路网。")
                return
            ak = ak.strip()
        self.do_import(ak)

    def do_import(self, ak):
        self.ak = ak
        self.import_done = False
        self.import_result = None
        self.import_lines = []
        self.show_result("正在从百度地图并行拉取真实路网（%d 城 / %d 路，约需 30~80 秒），界面保持可用…"
                         % (len(CITY_NAMES), len(ROAD_PAIRS)))
        self.status.config(text="数据源：%s    正在导入真实路网…" % self.source)
        self.root.update()
        t = threading.Thread(target=self._import_worker, args=(ak,), daemon=True)
        t.start()
        self.root.after(100, self._poll_import)

    def _import_worker(self, ak):
        lines = []
        result = network.fetch_real_network(ak, lines.append)
        self.import_result = result
        self.import_lines = lines
        self.import_done = True

    def _poll_import(self):
        if not self.import_done:
            self.root.after(100, self._poll_import)
            return
        self._import_done(self.import_result, self.import_lines)

    def _import_done(self, result, lines):
        if result is None:
            self.show_result("\n".join(lines))
            self.update_status()
            return
        new_cities, new_roads, new_points, new_curves, fail = result
        CITIES[:] = new_cities
        ROADS[:] = new_roads
        ROUTE_POINTS.clear()
        ROUTE_POINTS.update(new_points)
        ROUTE_CURVES.clear()
        ROUTE_CURVES.update(new_curves)
        geo.reset_view()
        self.graph = structures.build_graph()
        self.source = "百度真实路网"
        self.refresh_names()
        self.update_status()
        self.draw_graph()
        network._save_cache(new_cities, new_roads, new_points, new_curves)
        self.show_result("已导入百度真实路网并基于导入数据建模（源码不含任何虚构数值）\n%s\n\n"
                         "真实城市 %d 个、真实公路 %d 条（%d 条获取失败已跳过）\n"
                         "路网已缓存到 road_network_cache.json，下次启动将秒级加载"
                         % ("\n".join(lines), len(new_cities), len(new_roads), fail))
