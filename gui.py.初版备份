    def _path_report(self, path):
        segs = []
        names = []
        for k in range(len(path) - 1):
            u = path[k]
            v = path[k + 1]
            names.append(CITIES[u][0])
            segs.append("  %d. %s → %s   %d 公里"
                        % (k + 1, CITIES[u][0], CITIES[v][0], self.graph.get_weight(u, v)))
        names.append(CITIES[path[-1]][0])
        return " → ".join(names), "\n".join(segs)

    def on_shortest(self):
        a = self.combo_from.get()
        b = self.combo_to.get()
        if a == "" or b == "" or a == b:
            messagebox.showwarning("提示", "请选择两个不同的城市")
            return
        ia = city_index(a)
        ib = city_index(b)
        via_name = self.combo_via.get()
        via = -1
        if via_name != "" and via_name != "（不途经）":
            via = city_index(via_name)
            if via < 0 or via == ia or via == ib:
                messagebox.showwarning("提示", "途经城市需为路网中且不同于出发/到达城市")
                return
        if via < 0:
            path, dist = dijkstra(self.graph, ia, ib)
            title = "最短路线（Dijkstra）"
            if path is None:
                self.show_result("从 %s 到 %s 目前没有可通行的道路" % (a, b))
                self.draw_graph()
                return
        else:
            p1, d1 = dijkstra(self.graph, ia, via)
            if p1 is None:
                self.show_result("途经 %s 时，%s → %s 没有可通行的道路" % (via_name, a, b))
                self.draw_graph()
                return
            ban = set(p1[:-1])
            p2, d2 = dijkstra(self.graph, via, ib, ban)
            if p2 is None:
                self.show_result("不存在从 %s 经 %s 到 %s 且不重复经过任何城市或道路的路径"
                                 % (a, via_name, b))
                self.draw_graph()
                return
            path = p1 + p2[1:]
            dist = d1 + d2
            title = "最短路线（Dijkstra · 途经 %s）" % via_name
        names, segs = self._path_report(path)
        line = "─" * 26
        self.show_result("%s\n%s\n总里程 %d 公里 · 途经 %d 个中转 · 全程不重复\n%s\n%s"
                         % (title, names, dist, len(path) - 2, line, segs))
        self.draw_graph(path)

    def on_bfs(self):
        a = self.combo_from.get()
        b = self.combo_to.get()
        if a == "" or b == "" or a == b:
            messagebox.showwarning("提示", "请选择两个不同的城市")
            return
        ia = city_index(a)
        ib = city_index(b)
        via_name = self.combo_via.get()
        via = -1
        if via_name != "" and via_name != "（不途经）":
            via = city_index(via_name)
            if via < 0 or via == ia or via == ib:
                messagebox.showwarning("提示", "途经城市需为路网中且不同于出发/到达城市")
                return
        if via < 0:
            path, stops = bfs_min_stops(self.graph, ia, ib)
            title = "最少经停路线（BFS）"
            if path is None:
                self.show_result("从 %s 到 %s 目前没有可通行的道路" % (a, b))
                self.draw_graph()
                return
        else:
            p1, s1 = bfs_min_stops(self.graph, ia, via)
            if p1 is None:
                self.show_result("途经 %s 时，%s → %s 没有可通行的道路" % (via_name, a, b))
                self.draw_graph()
                return
            ban = set(p1[:-1])
            p2, s2 = bfs_min_stops(self.graph, via, ib, ban)
            if p2 is None:
                self.show_result("不存在从 %s 经 %s 到 %s 且不重复经过任何城市或道路的路径"
                                 % (a, via_name, b))
                self.draw_graph()
                return
            path = p1 + p2[1:]
            stops = s1 + s2
            title = "最少经停路线（BFS · 途经 %s）" % via_name
        names, segs = self._path_report(path)
        line = "─" * 26
        self.show_result("%s\n%s\n经停 %d 段 · 全程不重复 · 不保证总里程最短\n%s\n%s"
                         % (title, names, stops, line, segs))
        self.draw_graph(path)

    def on_prim(self):
        mst_edges, total = prim_mst(self.graph)
        if mst_edges is None:
            self.show_result("当前路网不连通，无法用一条公路网覆盖所有城市")
            self.draw_graph()
            return
        names = []
        for u, v in mst_edges:
            names.append("%s — %s（%d 公里）"
                         % (CITIES[u][0], CITIES[v][0], self.graph.get_weight(u, v)))
        self.show_result("最省钱公路网（Prim 最小生成树）：\n%s\n总里程：%d 公里\n"
                         "即用总里程最少的公路把所有城市连通"
                         % ("\n".join(names), total))
        self.draw_graph(None, mst_edges)

