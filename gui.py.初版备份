    def zoom_in(self):
        w = max(1, self.canvas.winfo_width())
        h = max(1, self.canvas.winfo_height())
        geo.zoom_around(w / 2.0, h / 2.0, 1.3)
        self.draw_graph()

    def zoom_out(self):
        w = max(1, self.canvas.winfo_width())
        h = max(1, self.canvas.winfo_height())
        geo.zoom_around(w / 2.0, h / 2.0, 1.0 / 1.3)
        self.draw_graph()

    def zoom_reset(self):
