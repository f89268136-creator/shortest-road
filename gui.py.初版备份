        self.draw_graph()

    def on_wheel(self, event):
        factor = 1.12 ** (event.delta / 120.0)
        geo.zoom_around(event.x, event.y, factor)
        self.draw_graph()

    def update_status(self):
        total_links = 0
        for u in range(self.graph.n):
            total_links += self.graph.adj[u].size()
        km = self.graph.total_km()
        conn = "连通" if self.graph.is_connected() else "不连通"
        self.status.config(text="数据源：%s    城市：%d 个    公路：%d 条    链表节点：%d    公路总里程：%d 公里    路网：%s    红=最短路径  绿=最省钱公路网"
                                 % (self.source, self.graph.n, self.graph.edge_num, total_links, km, conn))

    def edge_curve_points(self, u, v):
        a_name = CITIES[u][0]
        b_name = CITIES[v][0]
        stops = None
        if (a_name, b_name) in ROUTE_CURVES:
            stops = ROUTE_CURVES[(a_name, b_name)]
        elif (b_name, a_name) in ROUTE_CURVES:
            stops = list(ROUTE_CURVES[(b_name, a_name)])
            stops.reverse()
        pts = [geo.canvas_xy(u)]
        if stops is not None:
            for name in stops:
                lon, lat = ROUTE_POINTS[name]
                pts.append(geo.lonlat_xy(lon, lat))
        pts.append(geo.canvas_xy(v))
        return geo.catmull_rom(pts)

    def draw_graph(self, path=None, mst_edges=None):
        c = self.canvas
        c.delete("all")
        self.hover = None
        self.curves = {}
        pedges = []
        if path is not None:
            for i in range(len(path) - 1):
                a, b = path[i], path[i + 1]
                if a < b:
                    pedges.append((a, b))
                else:
                    pedges.append((b, a))
        for u in range(self.graph.n):
            p = self.graph.adj[u].head
            seen = {}
            while p is not None:
                v = p.city
                if u < v:
                    seq = seen.get(v, 0) + 1
                    seen[v] = seq
                    if seq == 1:
                        curve = self.edge_curve_points(u, v)
                        self.curves[(u, v)] = curve
                        c.create_line(geo.flatten_pts(curve), fill="#ffffff", width=7,
                                      smooth=True, tags=("edge", "base", "e_%d_%d" % (u, v)))
                        c.create_line(geo.flatten_pts(curve), fill="#9db4c9", width=2.5,
                                      smooth=True, tags=("edge", "e_%d_%d" % (u, v)))
                    else:
                        a = geo.canvas_xy(u)
                        b = geo.canvas_xy(v)
                        dx = b[0] - a[0]
                        dy = b[1] - a[1]
                        L = (dx * dx + dy * dy) ** 0.5
                        if L < 1e-6:
                            nx, ny = 0.0, -1.0
                        else:
                            nx = -dy / L
                            ny = dx / L
                        off = 7.0 if seq % 2 == 0 else -7.0
                        xa = a[0] + nx * off
                        ya = a[1] + ny * off
                        xb = b[0] + nx * off
                        yb = b[1] + ny * off
                        c.create_line(xa, ya, xb, yb, fill="#ffffff", width=5,
                                      tags=("edge", "base", "e_%d_%d" % (u, v)))
                        c.create_line(xa, ya, xb, yb, fill="#9db4c9", width=2,
                                      tags=("edge", "e_%d_%d" % (u, v)))
                p = p.next
        if mst_edges is not None:
            for u, v in mst_edges:
                curve = self.curves.get((u, v))
                if curve is None:
                    curve = self.edge_curve_points(u, v)
                c.create_line(geo.flatten_pts(curve), fill="#b5e6c8", width=10,
                              capstyle="round", joinstyle="round")
                c.create_line(geo.flatten_pts(curve), fill="#1f9d55", width=4,
                              capstyle="round", joinstyle="round")
        if path is not None:
            for u, v in pedges:
                curve = self.curves.get((u, v))
                if curve is None:
                    curve = self.edge_curve_points(u, v)
                c.create_line(geo.flatten_pts(curve), fill="#f9c4bf", width=10,
                              capstyle="round", joinstyle="round")
                c.create_line(geo.flatten_pts(curve), fill="#e5342e", width=4,
                              capstyle="round", joinstyle="round")
        for i in range(self.graph.n):
            x, y = geo.canvas_xy(i)
            name = CITIES[i][0]
            c.create_oval(x - 8, y - 8, x + 8, y + 8,
                          fill="#2e7ddb", outline="#ffffff", width=2)
            c.create_text(x, y + 16, text=name,
                          font=("Microsoft YaHei", 9), fill="#274b68")
            if path is not None and contains(path, i):
                c.create_oval(x - 11, y - 11, x + 11, y + 11,
                              outline="#f59e0b", width=2)
        c.create_rectangle(12, 12, 178, 88, fill="#ffffff", outline="#b8c8d8")
        c.create_line(20, 26, 44, 26, fill="#e5342e", width=4)
        c.create_text(52, 26, text="最短路径", anchor="w",
                      font=("Microsoft YaHei", 9), fill="#333")
        c.create_line(20, 46, 44, 46, fill="#1f9d55", width=4)
        c.create_text(52, 46, text="最省钱公路网", anchor="w",
                      font=("Microsoft YaHei", 9), fill="#333")
        c.create_line(20, 66, 44, 66, fill="#ffffff", width=7)
        c.create_line(20, 66, 44, 66, fill="#9db4c9", width=2.5)
        c.create_text(52, 66, text="普通公路（悬停查看道路）", anchor="w",
                      font=("Microsoft YaHei", 9), fill="#333")

    def _style_edge(self, u, v, fill, width):
        ids = self.canvas.find_withtag("e_%d_%d" % (u, v))
        for iid in ids:
            if "base" in self.canvas.gettags(iid):
                self.canvas.itemconfig(iid, fill="#ffffff")
            else:
                self.canvas.itemconfig(iid, fill=fill, width=width)

    def on_motion(self, event):
        if self.graph.n == 0 or len(self.curves) == 0:
            return
        x, y = event.x, event.y
        best = None
        best_d = 14.0
        for (u, v), curve in self.curves.items():
            d = geo.dist_to_polyline(x, y, curve)
            if d < best_d:
                best_d = d
                best = (u, v)
        if best == self.hover:
            return
        if self.hover is not None:
            hu, hv = self.hover
            self._style_edge(hu, hv, "#9db4c9", 2)
        self.hover = best
        if best is not None:
            u, v = best
            ds = self.graph.edges_between(u, v)
            self._style_edge(u, v, "#f59e0b", 4)
            self.status.config(text="道路：%s — %s    里程：%s 公里（%d 条平行路）"
                                     % (CITIES[u][0], CITIES[v][0],
                                        "/".join(str(d) for d in ds), len(ds)))
        else:
            self.update_status()

    def on_leave(self, event):
        if self.hover is not None:
            u, v = self.hover
            self._style_edge(u, v, "#9db4c9", 2)
            self.hover = None
            self.update_status()

